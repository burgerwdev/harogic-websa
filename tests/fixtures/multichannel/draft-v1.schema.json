{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:websa:multichannel:draft-v1",
  "title": "Multichannel draft-v1 portable contract",
  "description": "P2 fixture/experiments, P3/P4 native receiver/IQ/processed output and P5 backend IQ/result/published-audio recording contract; see MULTICHANNEL_DRAFT.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/receiver"
    },
    {
      "$ref": "#/$defs/fault"
    },
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/impact"
    },
    {
      "$ref": "#/$defs/processed_event"
    }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "stream": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "epoch": {
          "$ref": "#/$defs/u64"
        },
        "channel_id": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "source_id",
        "epoch",
        "channel_id"
      ],
      "additionalProperties": false
    },
    "baseband": {
      "type": "object",
      "properties": {
        "frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "passband_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transition_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "frequency_hz",
        "passband_hz",
        "transition_hz",
        "minimum_rate_hz"
      ],
      "additionalProperties": false
    },
    "processor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "demodulator",
            "decoder"
          ]
        },
        "mode": {
          "type": "string"
        },
        "minimum_rate_hz": {
          "type": "number",
          "minimum": 0
        },
        "bandwidth_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pcm_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "agc": {
          "type": "boolean"
        },
        "squelch_dbm": {
          "type": "number",
          "minimum": -200,
          "maximum": 0
        },
        "nr": {
          "type": "boolean"
        },
        "nr_algorithm": {
          "enum": ["wiener", "dfn", "gtcrn", "ul-unas", "fastenhancer"]
        },
        "nr_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nr_atten_db": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "kind",
        "mode",
        "minimum_rate_hz"
      ],
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "request",
            "consumer",
            "recording",
            "receiver",
            "capture"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "receiver_uid": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "listen",
            "digital",
            "iq"
          ]
        },
        "baseband": {
          "$ref": "#/$defs/baseband"
        },
        "processors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processor"
          }
        }
      },
      "required": [
        "name",
        "color",
        "tags",
        "enabled",
        "purpose",
        "baseband",
        "processors"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "input_index": {
          "$ref": "#/$defs/u64"
        },
        "output_index": {
          "$ref": "#/$defs/u64"
        },
        "fraction_num": {
          "$ref": "#/$defs/u64"
        },
        "fraction_den": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "input_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "actual_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delay_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "utc_reliable": {
          "type": "boolean"
        }
      },
      "required": [
        "input_index",
        "output_index",
        "fraction_num",
        "fraction_den",
        "input_rate_hz",
        "actual_rate_hz",
        "delay_seconds",
        "utc_reliable"
      ],
      "additionalProperties": false
    },
    "configure": {
      "type": "object",
      "properties": {
        "type": {
          "const": "configure"
        },
        "request_id": {
          "type": "string"
        },
        "expected_revision": {
          "$ref": "#/$defs/u64"
        },
        "receiver_uid": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id",
        "expected_revision",
        "receiver_uid",
        "config"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "type": {
          "const": "scene"
        },
        "request_id": {
          "type": "string"
        },
        "expected_revision": {
          "$ref": "#/$defs/u64"
        },
        "configs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receiver_uid": {
                "type": "string"
              },
              "config": {
                "$ref": "#/$defs/config"
              }
            },
            "required": [
              "receiver_uid",
              "config"
            ],
            "additionalProperties": false
          }
        },
        "capture_center_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "request_id",
        "expected_revision",
        "configs",
        "capture_center_hz"
      ],
      "additionalProperties": false
    },
    "receiver": {
      "type": "object",
      "properties": {
        "receiver_uid": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "display_number": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "$ref": "#/$defs/u64"
        },
        "confirmed": {
          "$ref": "#/$defs/config"
        },
        "stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/stream"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/clock"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "running",
            "stopped",
            "interrupted",
            "failed"
          ]
        },
        "fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/fault"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "receiver_uid",
        "source_id",
        "display_number",
        "revision",
        "confirmed",
        "stream",
        "clock",
        "state",
        "fault"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "type": "string"
        },
        "receiver_uid": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "iq",
            "audio",
            "results"
          ]
        },
        "format": {
          "enum": [
            "cf32_le",
            "pcm_f32",
            "jsonl"
          ]
        },
        "actual_rate_hz": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "starting",
            "active",
            "ended",
            "failed"
          ]
        },
        "fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/fault"
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "$ref": "#/$defs/u64"
        },
        "bytes": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "subscription_id",
        "receiver_uid",
        "kind",
        "format",
        "actual_rate_hz",
        "state",
        "fault"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "#/$defs/stream"
        },
        "first_input_index": {
          "$ref": "#/$defs/u64"
        },
        "samples": {
          "$ref": "#/$defs/u64"
        },
        "actual_rate_hz": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "segment_id": {
          "type": "string"
        },
        "first_output_index": {
          "$ref": "#/$defs/u64"
        },
        "fraction_num": {
          "$ref": "#/$defs/u64"
        },
        "fraction_den": {
          "$ref": "#/$defs/u64"
        },
        "config_revision": {
          "$ref": "#/$defs/u64"
        },
        "input_rate_hz": {
          "type": "number"
        },
        "frequency_hz": {
          "type": "number"
        },
        "delay_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseband": {
          "$ref": "#/$defs/baseband"
        },
        "utc_reliable": {
          "type": "boolean"
        },
        "events": {
          "$ref": "#/$defs/u64"
        },
        "mode": {
          "type": "string"
        },
        "prefix_missing": {
          "type": "boolean"
        },
        "last_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "source": {
          "type": "object"
        },
        "first_audio_index": {
          "$ref": "#/$defs/u64"
        },
        "next_audio_index": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "stream",
        "first_input_index",
        "samples",
        "actual_rate_hz",
        "end_reason"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "track_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "iq",
            "audio",
            "results"
          ]
        },
        "format": {
          "enum": [
            "cf32_le",
            "pcm_f32",
            "jsonl",
            "f32_le"
          ]
        },
        "source": {
          "enum": [
            "baseband",
            "analysis_audio",
            "decoder_results",
            "published_audio"
          ]
        },
        "compression": {
          "enum": [
            "zstd_auto_lossless",
            "none"
          ]
        },
        "state": {
          "enum": [
            "preparing",
            "waiting",
            "recording",
            "finalizing",
            "completed",
            "failed"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "raw_bytes": {
          "$ref": "#/$defs/u64"
        },
        "stored_bytes": {
          "$ref": "#/$defs/u64"
        },
        "container": {
          "enum": [
            "websa-iq-v2",
            "websa-results-v1",
            "websa-audio-v1"
          ]
        },
        "blocks": {
          "$ref": "#/$defs/u64"
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "index": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "complete": {
                "type": "boolean"
              },
              "valid_bytes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "file",
              "index",
              "complete"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "track_id",
        "kind",
        "format",
        "source",
        "compression",
        "state",
        "segments",
        "raw_bytes",
        "stored_bytes"
      ],
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "audio_format": { "enum": ["wav", "flac", "opus"] },
        "task_id": {
          "type": "string"
        },
        "receiver_uid": {
          "type": "string"
        },
        "state": {
          "enum": [
            "preparing",
            "waiting",
            "recording",
            "finalizing",
            "completed",
            "failed"
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/fault"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage_version": {
          "const": 2
        },
        "service_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "created_at_ms": {
          "$ref": "#/$defs/u64"
        },
        "updated_at_ms": {
          "$ref": "#/$defs/u64"
        },
        "accepted_bytes": {
          "$ref": "#/$defs/u64"
        },
        "queued_bytes": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "task_id",
        "receiver_uid",
        "state",
        "tracks",
        "fault"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "multichannel-draft-v1"
        },
        "transport": {
          "enum": [
            "fixture",
            "native"
          ]
        },
        "revision": {
          "$ref": "#/$defs/u64"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "max_channels": {
              "type": "integer",
              "minimum": 1
            },
            "capacity_target": {
              "type": "integer",
              "minimum": 1
            },
            "modes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recording": {
              "type": "boolean"
            },
            "monitor_mixing": {
              "type": "boolean"
            },
            "receiver_presets": { "type": "boolean" },
            "mode_descriptors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "analog",
                      "digital"
                    ]
                  },
                  "provider": {
                    "type": "string"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "outputs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "provider",
                  "available",
                  "outputs"
                ]
              }
            },
            "recording_kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "iq",
                  "audio",
                  "results"
                ]
              }
            },
            "recording_unavailable_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "iq_archive_read": {
              "type": "boolean"
            },
            "iq_file_demodulate": { "type": "boolean" },
            "iq_file_demodulate_modes": { "type": "array", "uniqueItems": true, "items": { "enum": ["am", "usb", "lsb", "nfm"] } },
            "iq_file_demodulate_max_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "iq_file_demodulate_offset": { "type": "boolean" },
            "iq_archive_collection": {
              "type": "boolean"
            },
            "iq_collection_max_samples": {
              "$ref": "#/$defs/u64"
            },
            "iq_collection_max_segments": {
              "type": "integer",
              "minimum": 1
            },
            "iq_archive_export": {
              "type": "boolean"
            },
            "iq_export_max_samples": {
              "$ref": "#/$defs/u64"
            },
            "iq_range_max_samples": {
              "$ref": "#/$defs/u64"
            },
            "results_archive_export": {
              "type": "boolean"
            },
            "audio_archive_export": {
              "type": "boolean"
            },
            "audio_archive_read": { "type": "boolean" },
            "audio_range_max_samples": { "$ref": "#/$defs/u64" },
            "audio_range_max_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "audio_flac_export": {
              "type": "boolean"
            },
            "audio_opus_export": { "type": "boolean" }
          },
          "required": [
            "max_channels",
            "capacity_target",
            "modes"
          ],
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string"
            },
            "center_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "usable_bandwidth_hz": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "input_rate_hz": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "epoch": {
              "$ref": "#/$defs/u64"
            },
            "state": {
              "enum": [
                "running",
                "failed",
                "idle"
              ]
            },
            "source_kind": {
              "enum": [
                "fixture",
                "hardware"
              ]
            },
            "parameters_state": {
              "enum": [
                "live",
                "last_known",
                "unknown",
                "simulated"
              ]
            }
          },
          "required": [
            "source_id",
            "center_hz",
            "usable_bandwidth_hz",
            "input_rate_hz",
            "epoch",
            "state"
          ],
          "additionalProperties": false
        },
        "receivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receiver"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "recordings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recording"
          }
        },
        "service_id": {
          "type": "string"
        },
        "state_revision": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "contract",
        "transport",
        "revision",
        "capabilities",
        "capture",
        "receivers",
        "outputs",
        "recordings"
      ],
      "additionalProperties": false
    },
    "command_create": {
      "type": "object",
      "properties": {
        "type": {
          "const": "create"
        },
        "request_id": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id",
        "config"
      ],
      "additionalProperties": false
    },
    "command_retire": {
      "type": "object",
      "properties": {
        "type": {
          "const": "retire"
        },
        "request_id": {
          "type": "string"
        },
        "receiver_uid": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "request_id",
        "receiver_uid"
      ],
      "additionalProperties": false
    },
    "command_output": {
      "type": "object",
      "properties": {
        "type": {
          "const": "output"
        },
        "request_id": {
          "type": "string"
        },
        "receiver_uid": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "request_id",
        "receiver_uid",
        "enabled"
      ],
      "additionalProperties": false
    },
    "command_record_start": {
      "type": "object",
      "properties": {
        "audio_format": { "enum": ["wav", "flac", "opus"] },
        "type": {
